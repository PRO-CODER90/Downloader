{
  "name": "downloader",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "postinstall": "node scripts/fetch-ytdlp.js",
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -n api,client -c blue,magenta \"node --watch dev-server.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
