# Optional: contents of a Netscape cookies.txt (for login-only / bot-checked content).
# On Vercel: Project → Settings → Environment Variables → YTDLP_COOKIES
YTDLP_COOKIES=
# Optional: override yt-dlp binary path
YTDLP_PATH=
# Allow arbitrary (non-listed) websites. Increases SSRF risk; keep false in production.
ALLOW_GENERIC_EXTRACTOR=false
