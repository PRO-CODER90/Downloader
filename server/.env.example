PORT=4000
# Path to yt-dlp binary (install: pip install -U yt-dlp)
YTDLP_PATH=yt-dlp
# Comma-separated allowed frontend origins (empty = same-origin only)
CORS_ORIGIN=
MAX_CONCURRENT_JOBS=3
# Minutes before finished files are deleted
FILE_TTL_MINUTES=30
# Optional: path to a Netscape cookies.txt for sites needing login
COOKIES_FILE=
# Or paste cookies.txt contents here (on Render you can also add a Secret File named cookies.txt)
YTDLP_COOKIES=
MAX_QUEUE=20
MAX_JOBS_PER_IP=3
MAX_FILESIZE=2G
JOB_TIMEOUT_MINUTES=30
# Allow arbitrary (non-listed) websites. Increases SSRF risk; keep false in production.
ALLOW_GENERIC_EXTRACTOR=false
