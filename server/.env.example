PORT=4000
# Path to yt-dlp binary (install: pip install -U yt-dlp)
YTDLP_PATH=yt-dlp
# Comma-separated allowed origins in dev (empty = allow all)
CORS_ORIGIN=http://localhost:5173
MAX_CONCURRENT_JOBS=3
# Minutes before finished files are deleted
FILE_TTL_MINUTES=30
# Optional: path to a Netscape cookies.txt for sites needing login
COOKIES_FILE=
